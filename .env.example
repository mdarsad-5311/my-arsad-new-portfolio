# =====================================================================
# MD ARSAD PORTFOLIO - EMAIL NOTIFICATION CONFIGURATION
# =====================================================================
# All enquiries from the Contact Form are dispatched to:
CONTACT_RECEIVER_EMAIL=mdarsadkgn5311@gmail.com

# ---------------------------------------------------------------------
# OPTION 1: GMAIL SMTP (Recommended if using Gmail App Password)
# ---------------------------------------------------------------------
# Step 1: Go to Google Account > Security > 2-Step Verification
# Step 2: At bottom of page, create an "App Password" (name it "Portfolio")
# Step 3: Paste the 16-character generated app password below (without spaces)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=mdarsadkgn5311@gmail.com
SMTP_PASS=your_16_char_google_app_password_here
SMTP_FROM="MD Arsad Portfolio" <mdarsadkgn5311@gmail.com>

# ---------------------------------------------------------------------
# OPTION 2: RESEND (Modern Vercel-native Email API)
# ---------------------------------------------------------------------
# If you prefer Resend (free tier: 3,000 emails/month, 100/day):
